# Copy to .env and fill in. Never commit .env.

# --- Model access -----------------------------------------------------------
# "developer" = Gemini Developer API with an API key (prototype).
# "vertex"    = Vertex AI (production). Uses Google Cloud credentials, not a key.
LLM_BACKEND=developer
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
# Spec decision D3: global endpoint for now (no data-residency guarantee).
GOOGLE_CLOUD_LOCATION=global

# --- Models per step (spec section 3) ---------------------------------------
MODEL_EXTRACTION=gemini-3.1-flash-lite
MODEL_QUESTION=gemini-3.8-flash
# Spec decision D7: a General Availability model, so the prompt optimizer can target it later.
MODEL_FINAL_ICP=gemini-2.5-pro

# --- Database ---------------------------------------------------------------
# Postgres for real use. SQLite is fine for local development and is what the tests use.
DATABASE_URL=postgresql+psycopg://icp:icp@localhost:5432/icp_chatbot
# Create tables on startup (development only). Production runs `alembic upgrade head`.
AUTO_CREATE_TABLES=false

# --- Interview limits (spec section 5.5) ------------------------------------
QUICK_MODE_QUESTION_CAP=20
DETAIL_MODE_TOTAL_CAP=25
DETAIL_MODE_EXTRA_QUESTIONS=5
MAX_ANSWER_CHARS=2000

# --- Time budgets -----------------------------------------------------------
ENRICHMENT_TIMEOUT_SECONDS=40
ENRICHMENT_CACHE_DAYS=30
LLM_TIMEOUT_SECONDS=20

# --- Cost and abuse controls (spec section 12) -------------------------------
DAILY_SESSION_CAP_PER_TENANT=200
DAILY_TOKEN_CAP_PER_TENANT=2000000
GLOBAL_DAILY_SESSION_CAP=2000
GLOBAL_DAILY_TOKEN_CAP=20000000
REQUESTS_PER_MINUTE_PER_TENANT=60
ABANDON_AFTER_HOURS=48
